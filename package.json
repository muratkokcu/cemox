{
  "name": "cemox-appointment-system",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Cem Avat full-custom appointment system (React + Rust)",
  "scripts": {
    "dev": "concurrently -k -n api,web -c green,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "cargo run --manifest-path server/Cargo.toml",
    "dev:web": "vite",
    "build": "tsc -b && vite build && npm run build:api",
    "build:api": "cargo build --release --manifest-path server/Cargo.toml",
    "start": "./server/target/release/cemox-server",
    "test": "cargo test --manifest-path server/Cargo.toml",
    "check": "tsc -b && cargo fmt --manifest-path server/Cargo.toml --check && cargo clippy --manifest-path server/Cargo.toml --all-targets -- -D warnings && node scripts/check.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "lucide-react": "^1.28.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "concurrently": "^10.0.4",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.0"
  }
}

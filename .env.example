NODE_ENV=development
PORT=4100
APP_ORIGIN=http://localhost:5100
DATABASE_PATH=./data/appointments.sqlite
ADMIN_EMAIL=cemavat@gmail.com
ADMIN_PASSWORD=change-this-long-password
SESSION_SECRET=change-this-to-at-least-32-random-characters

# SMTP ayarlanmazsa e-postalar development ortamında konsola yazılır.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Cem Avat Randevu <randevu@example.com>"

# Google Takvim senkronu (isteğe bağlı).
# Servis hesabı anahtarı: JSON dosyasının yolu ya da JSON'un kendisi.
# Antrenör kendi takvimini bu hesabın e-postasıyla paylaşır
# ("Etkinliklerde değişiklik yap" izniyle); hangi takvime yazılacağı panelden seçilir.
GOOGLE_SERVICE_ACCOUNT=

# Uygulamanın önünde kaç katman GÜVENİLEN ters vekil var.
# 0 (varsayılan): X-Forwarded-For tamamen yok sayılır, istemci adresi soketten alınır.
# 1: tek katman nginx/Caddy arkasında. Vekiller başlığa ekleme yaptığı için
#    doğru değer zincirin sonundadır; en soldakini almak adresi saldırgana bırakır
#    ve oran sınırlarının tamamı tek bir başlıkla aşılabilir hale gelir.
TRUSTED_PROXY_HOPS=0
